
@article{larios_computational_2018,
	title = {A computational investigation of the finite-time blow-up of the {3D} incompressible {Euler} equations based on the {Voigt} regularization},
	volume = {32},
	issn = {1432-2250},
	url = {https://doi.org/10.1007/s00162-017-0434-0},
	doi = {10.1007/s00162-017-0434-0},
	abstract = {We report the results of a computational investigation of two blow-up criteria for the 3D incompressible Euler equations. One criterion was proven in a previous work, and a related criterion is proved here. These criteria are based on an inviscid regularization of the Euler equations known as the 3D Euler–Voigt equations, which are known to be globally well-posed. Moreover, simulations of the 3D Euler–Voigt equations also require less resolution than simulations of the 3D Euler equations for fixed values of the regularization parameter \$\${\textbackslash}alpha {\textgreater}0\$\$. Therefore, the new blow-up criteria allow one to gain information about possible singularity formation in the 3D Euler equations indirectly, namely by simulating the better-behaved 3D Euler–Voigt equations. The new criteria are only known to be sufficient criterion for blow-up. Therefore, to test the robustness of the inviscid-regularization approach, we also investigate analogous criteria for blow-up of the 1D Burgers equation, where blow-up is well known to occur.},
	language = {en},
	number = {1},
	urldate = {2025-04-19},
	journal = {Theoretical and Computational Fluid Dynamics},
	author = {Larios, Adam and Petersen, Mark R. and Titi, Edriss S. and Wingate, Beth},
	month = feb,
	year = {2018},
	keywords = {{\textbackslash}({\textbackslash}alpha {\textbackslash})-Models, 35Q30, 76A10, 76B03, 76D03, 76F20, 76F55, 76F65, 76W05, Blow-up criterion for Euler, Euler–Voigt, Inviscid regularization, Navier–Stokes–Voigt, Turbulence models},
	pages = {23--34},
	file = {Full Text PDF:C\:\\Users\\bensl\\Zotero\\storage\\WAWHM52T\\Larios et al. - 2018 - A computational investigation of the finite-time blow-up of the 3D incompressible Euler equations ba.pdf:application/pdf},
}

@article{kang_maximum_2020,
	title = {Maximum {Amplification} of {Enstrophy} in {3D} {Navier}-{Stokes} {Flows}},
	volume = {893},
	issn = {0022-1120, 1469-7645},
	url = {http://arxiv.org/abs/1909.00041},
	doi = {10.1017/jfm.2020.204},
	abstract = {This investigation concerns a systematic search for potentially singular behavior in 3D Navier-Stokes flows. Enstrophy serves as a convenient indicator of the regularity of solutions to the Navier Stokes system --- as long as this quantity remains finite, the solutions are guaranteed to be smooth and satisfy the equations in the classical (pointwise) sense. However, there are no estimates available with finite a priori bounds on the growth of enstrophy and hence the regularity problem for the 3D Navier-Stokes system remains open. In order to quantify the maximum possible growth of enstrophy, we consider a family of PDE optimization problems in which initial conditions with prescribed enstrophy \${\textbackslash}mathcal\{E\}\_0\$ are sought such that the enstrophy in the resulting Navier-Stokes flow is maximized at some time \$T\$. Such problems are solved computationally using a large-scale adjoint-based gradient approach derived in the continuous setting. By solving these problems for a broad range of values of \${\textbackslash}mathcal\{E\}\_0\$ and \$T\$, we demonstrate that the maximum growth of enstrophy is in fact finite and scales in proportion to \${\textbackslash}mathcal\{E\}\_0{\textasciicircum}\{3/2\}\$ as \${\textbackslash}mathcal\{E\}\_0\$ becomes large. Thus, in such worst-case scenario the enstrophy still remains bounded for all times and there is no evidence for formation of singularity in finite time. We also analyze properties of the Navier-Stokes flows leading to the extreme enstrophy values and show that this behavior is realized by a series of vortex reconnection events.},
	urldate = {2025-04-19},
	journal = {Journal of Fluid Mechanics},
	author = {Kang, Di and Yun, Dongfang and Protas, Bartosz},
	month = jun,
	year = {2020},
	note = {arXiv:1909.00041 [physics]},
	keywords = {Mathematics - Analysis of PDEs, Physics - Fluid Dynamics},
	pages = {A22},
	file = {Preprint PDF:C\:\\Users\\bensl\\Zotero\\storage\\XSUKLHS4\\Kang et al. - 2020 - Maximum Amplification of Enstrophy in 3D Navier-Stokes Flows.pdf:application/pdf;Snapshot:C\:\\Users\\bensl\\Zotero\\storage\\3G95N8LE\\1909.html:text/html},
}

@article{protas_systematic_2022,
	title = {Systematic {Search} {For} {Extreme} and {Singular} {Behavior} in {Some} {Fundamental} {Models} of {Fluid} {Mechanics}},
	volume = {380},
	issn = {1364-503X, 1471-2962},
	url = {http://arxiv.org/abs/2112.14917},
	doi = {10.1098/rsta.2021.0035},
	abstract = {This review article offers a survey of the research program focused on a systematic computational search for extreme and potentially singular behavior in hydrodynamic models motivated by open questions concerning the possibility of a finite-time blow-up in the solutions of the Navier-Stokes system. Inspired by the seminal work of Lu \& Doering (2008), we sought such extreme behavior by solving PDE optimization problems with objective functionals chosen based on certain conditional regularity results and a priori estimates available for different models. No evidence for singularity formation was found in extreme Navier-Stokes flows constructed in this manner in 3D. We also discuss the results obtained for 1D Burgers and 2D Navier-Stokes systems, and while singularities are ruled out in these flows, the results presented provide interesting insights about sharpness of different energy-type estimates known for these systems. Connections to other bounding techniques are also briefly discussed.},
	number = {2225},
	urldate = {2025-04-19},
	journal = {Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences},
	author = {Protas, Bartosz},
	month = jun,
	year = {2022},
	note = {arXiv:2112.14917 [math]},
	keywords = {Mathematics - Analysis of PDEs, Physics - Fluid Dynamics, Mathematics - Optimization and Control},
	pages = {20210035},
	file = {Preprint PDF:C\:\\Users\\bensl\\Zotero\\storage\\BLQNCIPV\\Protas - 2022 - Systematic Search For Extreme and Singular Behavior in Some Fundamental Models of Fluid Mechanics.pdf:application/pdf;Snapshot:C\:\\Users\\bensl\\Zotero\\storage\\YP44BPFY\\2112.html:text/html},
}

@article{robinson_navierstokes_2020,
	title = {The {Navier}–{Stokes} regularity problem},
	volume = {378},
	url = {https://royalsocietypublishing.org/doi/10.1098/rsta.2019.0526},
	doi = {10.1098/rsta.2019.0526},
	abstract = {There is currently no proof guaranteeing that, given a smooth initial condition, the three-dimensional Navier–Stokes equations have a unique solution that exists for all positive times. This paper reviews the key rigorous results concerning the existence and uniqueness of solutions for this model. In particular, the link between the regularity of solutions and their uniqueness is highlighted.

This article is part of the theme issue ‘Stokes at 200 (Part 1)’.},
